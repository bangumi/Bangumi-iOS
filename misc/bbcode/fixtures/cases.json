{
  "comment": "Language-neutral BBCode parser fixtures. Tree nodes: {\"text\": \"...\"} for plain text, {\"tag\": \"br\"} for line breaks, {\"tag\": \"<name>\", \"attr\": \"...\", \"children\": [...]} for tags. Adjacent plain text nodes are merged before comparison. 'text' asserts the joined visible text (br renders as \\n). 'inside'/'notInside' assert whether some <tag> subtree contains the given text. Cases are ported from bangumi/frontend packages/utils/bbcode/__test__/parser.test.ts plus app-specific extensions (list/ruby/photo/bmo, case-insensitive tags, catalog sticker canonicalization).",
  "cases": [
    {
      "name": "text with unknown tag stays literal",
      "input": "啊aあ\n)[bs][/bs]222",
      "text": "啊aあ\n)[bs][/bs]222"
    },
    {
      "name": "CRLF line breaks become br nodes",
      "input": "a\r\nb\r\n\r\nc",
      "tree": [
        { "text": "a" },
        { "tag": "br" },
        { "text": "b" },
        { "tag": "br" },
        { "tag": "br" },
        { "text": "c" }
      ]
    },
    {
      "name": "lone CR and LF line breaks",
      "input": "a\rb\nc",
      "tree": [
        { "text": "a" },
        { "tag": "br" },
        { "text": "b" },
        { "tag": "br" },
        { "text": "c" }
      ]
    },
    {
      "name": "CRLF inside tags",
      "input": "[b]粗体[/b]\r\n[color=red]红\r\n字[/color]",
      "tree": [
        { "tag": "b", "children": [{ "text": "粗体" }] },
        { "tag": "br" },
        {
          "tag": "color",
          "attr": "red",
          "children": [{ "text": "红" }, { "tag": "br" }, { "text": "字" }]
        }
      ]
    },
    {
      "name": "bangumi stickers and kaomoji-like text",
      "input": "[(bgm38)[/(=A=)](=///=)(bgm01)",
      "tree": [
        { "text": "[" },
        { "tag": "bgm", "attr": "bgm38" },
        { "text": "[/(=A=)](=///=)" },
        { "tag": "bgm", "attr": "bgm01" }
      ]
    },
    {
      "name": "url with attribute",
      "input": "[url=http://chii.in]bgm[/url]",
      "tree": [
        { "tag": "url", "attr": "http://chii.in", "children": [{ "text": "bgm" }] }
      ]
    },
    {
      "name": "url with child text as href",
      "input": " [url]http://chii.in/[/url]",
      "tree": [
        { "text": " " },
        { "tag": "url", "children": [{ "text": "http://chii.in/" }] }
      ]
    },
    {
      "name": "invalid mixed bbcode round-trips as text",
      "input": "[ba]bgm[/b](bg38)[b]加粗[b]",
      "text": "[ba]bgm[/b](bg38)[b]加粗[b]"
    },
    {
      "name": "img after text and newline",
      "input": "存放于其他网络服务器的图片：\n[img]http://chii.in/img/ico/bgm88-31.gif[/img]",
      "tree": [
        { "text": "存放于其他网络服务器的图片：" },
        { "tag": "br" },
        { "tag": "img", "children": [{ "text": "http://chii.in/img/ico/bgm88-31.gif" }] }
      ]
    },
    {
      "name": "simple tags suite",
      "input": "我是[mask]马赛克文字[/mask]\n[s]删除线文字[/s]\n[u]下划线文字[/u]\n[i]斜体字[/i]\n[b]粗体字[/b]\n[color=red]彩[/color][color=green]色[/color][color=blue]的[/color][color=orange]哟[/color]\n[quote]引用[/quote]\n[left]左[/left]\n[right]右[/right]\n[center]中[/center]\n[indent]块引用[/indent]\n[float]浮动[/float]\n",
      "tree": [
        { "text": "我是" },
        { "tag": "mask", "children": [{ "text": "马赛克文字" }] },
        { "tag": "br" },
        { "tag": "s", "children": [{ "text": "删除线文字" }] },
        { "tag": "br" },
        { "tag": "u", "children": [{ "text": "下划线文字" }] },
        { "tag": "br" },
        { "tag": "i", "children": [{ "text": "斜体字" }] },
        { "tag": "br" },
        { "tag": "b", "children": [{ "text": "粗体字" }] },
        { "tag": "br" },
        { "tag": "color", "attr": "red", "children": [{ "text": "彩" }] },
        { "tag": "color", "attr": "green", "children": [{ "text": "色" }] },
        { "tag": "color", "attr": "blue", "children": [{ "text": "的" }] },
        { "tag": "color", "attr": "orange", "children": [{ "text": "哟" }] },
        { "tag": "br" },
        { "tag": "quote", "children": [{ "text": "引用" }] },
        { "tag": "br" },
        { "tag": "left", "children": [{ "text": "左" }] },
        { "tag": "br" },
        { "tag": "right", "children": [{ "text": "右" }] },
        { "tag": "br" },
        { "tag": "center", "children": [{ "text": "中" }] },
        { "tag": "br" },
        { "tag": "indent", "children": [{ "text": "块引用" }] },
        { "tag": "br" },
        { "tag": "float", "children": [{ "text": "浮动" }] },
        { "tag": "br" }
      ]
    },
    {
      "name": "nested color and size",
      "input": "[color=green]nest[size=16]更新：[/size][/color]",
      "tree": [
        {
          "tag": "color",
          "attr": "green",
          "children": [
            { "text": "nest" },
            { "tag": "size", "attr": "16", "children": [{ "text": "更新：" }] }
          ]
        }
      ]
    },
    {
      "name": "nested same tag",
      "input": "[color=green][color=blue]更新：[/color][/color]",
      "tree": [
        {
          "tag": "color",
          "attr": "green",
          "children": [
            { "tag": "color", "attr": "blue", "children": [{ "text": "更新：" }] }
          ]
        }
      ]
    },
    {
      "name": "code keeps raw content",
      "input": "[code]afafaf[b]bbbbb[/b][/code]",
      "tree": [
        { "tag": "code", "children": [{ "text": "afafaf[b]bbbbb[/b]" }] }
      ]
    },
    {
      "name": "code nest 1",
      "input": "[code][code]1[/code][/code] [code]2[/code]",
      "tree": [
        { "tag": "code", "children": [{ "text": "[code]1" }] },
        { "text": "[/code] " },
        { "tag": "code", "children": [{ "text": "2" }] }
      ]
    },
    {
      "name": "code nest 2",
      "input": "[code]1[/code][/code] [code]2[/code]",
      "tree": [
        { "tag": "code", "children": [{ "text": "1" }] },
        { "text": "[/code] " },
        { "tag": "code", "children": [{ "text": "2" }] }
      ]
    },
    {
      "name": "code nest 3",
      "input": "[code][code]1[/code] [code]2[/code]",
      "tree": [
        { "tag": "code", "children": [{ "text": "[code]1" }] },
        { "text": " " },
        { "tag": "code", "children": [{ "text": "2" }] }
      ]
    },
    {
      "name": "empty tags are invalid",
      "input": "[b][/b][mask][/mask][s][/]",
      "text": "[b][/b][mask][/mask][s][/]"
    },
    {
      "name": "invalid urls stay literal",
      "input": "[url]Bangumi 番组计划[/url][url=sfaf]番组计划[/url][url][/url]",
      "text": "[url]Bangumi 番组计划[/url][url=sfaf]番组计划[/url][url][/url]"
    },
    {
      "name": "unsafe url protocols are rejected",
      "input": "[url=javascript:alert(1)]链接[/url][img]data:text/html,unsafe[/img]",
      "text": "[url=javascript:alert(1)]链接[/url][img]data:text/html,unsafe[/img]"
    },
    {
      "name": "invalid stickers stay literal",
      "input": "(bgmab)(bgm38a",
      "text": "(bgmab)(bgm38a"
    },
    {
      "name": "character stickers with catalog gaps",
      "input": "(musume_03)(blake_03)(musume_97)(musume_118)",
      "tree": [
        { "tag": "bgm", "attr": "musume_03" },
        { "tag": "bgm", "attr": "blake_03" },
